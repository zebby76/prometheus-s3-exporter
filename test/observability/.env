# Read by docker compose for test/observability/compose.yaml.

# The SeaweedFS admin identity; the exporters and the seed job sign with it.
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin-secret

# Traefik's ports on the host. 80 clashes with base-php's demo stack if both run.
OBS_HTTP_PORT=80
OBS_TRAEFIK_PORT=8888

# Idle timeout of the load balancer in front of the storage.
LB_IDLE_TIMEOUT=60s

# name:count:min_bytes:max_bytes,... -- empty keeps the defaults in seed.py.
SEED_BUCKETS=
